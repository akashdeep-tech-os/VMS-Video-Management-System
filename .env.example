# --- Application ---
APP_NAME=Live Streaming
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Database (relative paths resolve against backend/) ---
DATABASE_URL=sqlite:///./streaming.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (loaded by Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- MediaMTX ---
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WEBRTC_URL=http://localhost:8889
